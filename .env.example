# Backend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000

# Groq (LLM extraction / referral letter generation)
GROQ_API_KEY=your_groq_api_key_here

# Gemini (voice agent Live API)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (Supabase PostgreSQL) — direct connection.
# If the Supavisor pooler rejects your project with "ENOTFOUND tenant/user", use this direct form.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-KEY]
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_[YOUR-KEY]

# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_[YOUR-CLERK-PUB-KEY]
CLERK_SECRET_KEY=sk_test_[YOUR-CLERK-SECRET-KEY]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
