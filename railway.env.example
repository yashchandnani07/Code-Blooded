# Railway Environment Variables for Lumina API Backend
# Set these in Railway Dashboard > Variables
RAILWAY_PRIVATE_DOMAIN=web.railway.internal
# Database (Supabase PostgreSQL) - REQUIRED
# Use direct connection string, not pooler
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase Credentials - REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-KEY]
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_[YOUR-KEY]

# Clerk Authentication - REQUIRED
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_[YOUR-CLERK-PUB-KEY]
CLERK_SECRET_KEY=sk_test_[YOUR-CLERK-SECRET-KEY]
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Groq API Key for LLM features - REQUIRED
GROQ_API_KEY=gsk_[YOUR-GROQ-KEY]

# API Configuration
NEXT_PUBLIC_API_URL=https://[YOUR-RAILWAY-APP].railway.app
PORT=7860

# Address the QR code points at (used for phone scanning in local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: HuggingFace token for model downloads
HF_TOKEN=hf_[YOUR-HF-TOKEN]
